# LifeEvent Backend Configuration (Prototype)
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
PROJECT_NAME="LifeEvent API"

# Optional Gemini LLM Integration
# If omitted or empty, the entire system runs 100% deterministically using the built-in rule engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=lifeevent_db
USE_MYSQL=false
